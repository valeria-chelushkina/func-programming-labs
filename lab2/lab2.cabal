cabal-version:      3.0
name:               lab2
version:            0.1.0.0
build-type:         Simple
synopsis:           Parallel numerical integration in Haskell

executable lab2
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:    Integration
                  , Integrands
  build-depends:    base >= 4.18 && < 5
                  , async
  default-language: Haskell2010
  ghc-options:      -Wall -O2 -threaded -rtsopts -with-rtsopts=-N
