cabal-version:      3.0
name:               lab3
version:            0.1.0.0
build-type:         Simple
synopsis:           Textbook text processing in Haskell

executable lab3
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:    Text.Types
                  , Text.Normalize
                  , Text.Tokenize
                  , Text.Analysis
  build-depends:    base >= 4.18 && < 5
                  , text
                  , bytestring
  default-language: Haskell2010
  ghc-options:      -Wall
