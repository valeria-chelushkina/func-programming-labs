cabal-version:      3.0
name:               dept-resources
version:            0.1.0.0
build-type:         Simple
synopsis:           Information resources of the department
description:        Course project for Functional Programming.

executable dept-resources
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:    Model.Resource
                  , Model.Author
                  , Model.ResourceUrl
                  , Model.Lookup
                  , Model.Filters
                  , Model.User
                  , Model.Stats
                  , Db.Config
                  , Db.Connection
                  , Repository.Class
                  , Repository.Resource
                  , Repository.Author
                  , Repository.ResourceUrl
                  , Repository.Lookup
                  , Repository.Search
                  , Repository.User
                  , Repository.Stats
                  , Service.Resource
                  , Service.Author
                  , Service.Lookup
                  , Service.User
                  , Service.Stats
                  , Ui.Render
  build-depends:    base >= 4.18 && < 5
                  , mysql-haskell >= 1.3 && < 1.4
                  , io-streams
                  , text
                  , bytestring
                  , time
                  , containers
  default-language: Haskell2010
  ghc-options:      -Wall
