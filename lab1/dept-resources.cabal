cabal-version:      3.0
name:               dept-resources
version:            0.1.0.0
build-type:         Simple
synopsis:           Information resources of the department
description:        Course project for Functional Programming.

executable dept-resources
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:    Model.Resource
                  , Model.Author
                  , Model.ResourceUrl
                  , Model.Lookup
                  , Model.Filters
                  , Model.User
                  , Model.Stats
                  , Db.Config
                  , Db.Connection
                  , Repository.Class
                  , Repository.Resource
                  , Repository.Author
                  , Repository.ResourceUrl
                  , Repository.Lookup
                  , Repository.Search
                  , Repository.User
                  , Repository.Stats
                  , Service.Resource
                  , Service.Author
                  , Service.Lookup
                  , Service.User
                  , Service.Stats
                  , Web.App
                  , Web.Layout
                  , Web.Components
                  , Web.Forms
                  , Web.Pages.Dashboard
                  , Web.Pages.Resources
                  , Web.Pages.ResourceDetails
                  , Web.Pages.ResourceForm
                  , Web.Pages.Authors
                  , Web.Pages.Users
                  , Web.Pages.Stats
                  , Web.Pages.NotFound
  build-depends:    base >= 4.18 && < 5
                  , mysql-haskell >= 1.3 && < 1.4
                  , io-streams
                  , text
                  , bytestring
                  , time
                  , containers
                  , scotty >= 0.22 && < 0.31
                  , lucid >= 2.11 && < 2.12
                  , warp
                  , streaming-commons
  default-language: Haskell2010
  ghc-options:      -Wall -threaded
